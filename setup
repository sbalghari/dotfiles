#!/usr/bin/env python3

import shutil
import subprocess
from pathlib import Path
from typing import Dict, Tuple


REPO_ROOT = Path(__file__).parent.resolve()
CONFIG_DIR = REPO_ROOT / "config"
SCRIPTS_DIR = REPO_ROOT / "scripts"
APPLICATIONS_DIR = REPO_ROOT / "applications"
HOME = Path.home()
CONFIG_HOME = HOME / ".config"
LOCAL_BIN = HOME / ".local" / "bin"
USER_APPLICATIONS = HOME / ".local" / "share" / "applications"

# Files/dirs to skip (generated, secrets, etc.)
SKIP_PATTERNS = [
    "*.db",
    "*.db-*",
    "history.db*",
    "secrets.lua",
    "current-theme.conf",
    "lazy-lock.json",
    ".neoconf.json",
    "themes/noctalia.conf",  # generated by matugen
    "colors/noctalia.conf",  # generated
    "noctalia.css",  # generated by Noctalia
    "__pycache__",
    "*.pyc",
    ".*",  # dotfiles inside config/ (keep git-ignored generated ones out)
]


def should_skip(path: Path) -> bool:
    name = path.name
    for pattern in SKIP_PATTERNS:
        if path.match(pattern) or name == pattern:
            return True
    return False


def symlink_map() -> Dict[Path, Path]:
    """Map repo paths to their home targets.

    config/* -> ~/.config/*, scripts/* -> ~/.local/bin/*
    """
    result = {}
    if CONFIG_DIR.is_dir():
        for item in sorted(CONFIG_DIR.iterdir()):
            if should_skip(item):
                continue
            result[item] = CONFIG_HOME / item.name
    if SCRIPTS_DIR.is_dir():
        for item in sorted(SCRIPTS_DIR.iterdir()):
            if should_skip(item):
                continue
            result[item] = LOCAL_BIN / item.name
    return result


def backup_existing(target: Path) -> Path | None:
    """Move existing file/dir to backup with timestamp."""
    if not target.exists() and not target.is_symlink():
        return None
    timestamp = subprocess.check_output(["date", "+%Y%m%d-%H%M%S"], text=True).strip()
    backup = target.with_suffix(target.suffix + f".bak.{timestamp}")
    print(f"  Backing up {target} -> {backup}")
    shutil.move(str(target), str(backup))
    return backup


def create_symlink(source: Path, target: Path, force: bool = False) -> bool:
    """Create symlink from source to target."""
    target.parent.mkdir(parents=True, exist_ok=True)

    if target.is_symlink():
        current = target.readlink()
        if current == source:
            print(f"  ✓ Already linked: {target} -> {source}")
            return True
        if force:
            target.unlink()
        else:
            print(f"  ✗ Symlink exists with different target: {target} -> {current}")
            return False
    elif target.exists():
        if force:
            backup_existing(target)
        else:
            print(f"  ✗ Exists (not a symlink): {target}")
            return False

    target.symlink_to(source)
    print(f"  ✓ Linked: {target} -> {source}")
    return True


def hide_desktop_entries(force: bool = False, dry_run: bool = False) -> Tuple[int, int]:
    """Copy curated .desktop files from <root>/applications into
    ~/.local/share/applications, shadowing the system entries (they carry
    Hidden=true). No files are generated — the repo copies are the source.
    """
    success = 0
    failed = 0

    print(f"Copying hidden desktop entries from {APPLICATIONS_DIR}...")
    if not APPLICATIONS_DIR.is_dir():
        print(f"  ⚠ Applications dir not found: {APPLICATIONS_DIR}")
        return 0, 1

    entries = sorted(APPLICATIONS_DIR.glob("*.desktop"))
    if not entries:
        print("  No .desktop files in applications/")
        return 0, 0

    USER_APPLICATIONS.mkdir(parents=True, exist_ok=True)
    for source in entries:
        target = USER_APPLICATIONS / source.name

        if dry_run:
            print(f"  → Would copy: {target} <- {source}")
            success += 1
            continue

        if target.exists() and not force:
            if target.read_bytes() == source.read_bytes():
                print(f"  ✓ Already in place: {target}")
                success += 1
                continue
            print(f"  ✗ Exists and differs, use --force/--repair: {target}")
            failed += 1
            continue

        if target.exists():
            backup_existing(target)
        shutil.copy2(source, target)
        print(f"  ✓ Copied: {target}")
        success += 1

    print(f"\nDone: {success} copied, {failed} failed")
    return success, failed


def install(force: bool = False, dry_run: bool = False, repair: bool = False) -> Tuple[int, int]:
    """Install all dotfiles (symlinks + hidden desktop entries)."""
    force = force or repair
    success = 0
    failed = 0

    print(f"Installing dotfiles from {REPO_ROOT}")
    print(f"Target: {HOME}")
    if dry_run:
        print("DRY RUN - no changes will be made")
    print()

    for source, target in symlink_map().items():
        if not source.exists():
            print(f"  ⚠ Source not found: {source}")
            failed += 1
            continue

        if dry_run:
            print(f"  → Would link: {target} -> {source}")
            success += 1
            continue

        if create_symlink(source, target, force):
            success += 1
        else:
            failed += 1

    print()
    hid_s, hid_f = hide_desktop_entries(force=force, dry_run=dry_run)
    success += hid_s
    failed += hid_f

    print(f"\nDone: {success} linked/copied, {failed} failed/skipped")
    return success, failed


def uninstall(dry_run: bool = False) -> Tuple[int, int]:
    """Remove symlinks and desktop entries created by this manager."""
    success = 0
    failed = 0

    print("Removing managed symlinks...")
    if dry_run:
        print("DRY RUN - no changes will be made")
    print()

    for source, target in symlink_map().items():
        if not target.is_symlink():
            if target.exists():
                print(f"  ✗ Not a symlink (manual?): {target}")
                failed += 1
            continue

        current = target.readlink()
        if current != source:
            print(f"  ⚠ Points elsewhere: {target} -> {current}")
            failed += 1
            continue

        if dry_run:
            print(f"  → Would remove: {target}")
            success += 1
            continue

        target.unlink()
        print(f"  ✓ Removed: {target}")
        success += 1

        # Clean empty parent dirs
        parent = target.parent
        while parent != HOME and parent != CONFIG_HOME and parent != LOCAL_BIN:
            try:
                if parent.is_dir() and not any(parent.iterdir()):
                    parent.rmdir()
                    print(f"  ✓ Removed empty dir: {parent}")
                else:
                    break
            except OSError:
                break
            parent = parent.parent

    print()
    print("Removing copied desktop entries...")
    if APPLICATIONS_DIR.is_dir():
        for source in sorted(APPLICATIONS_DIR.glob("*.desktop")):
            target = USER_APPLICATIONS / source.name
            if not target.exists():
                continue
            if target.is_symlink() or target.read_bytes() != source.read_bytes():
                print(f"  ⚠ Not a managed copy (skipping): {target}")
                failed += 1
                continue
            if dry_run:
                print(f"  → Would remove: {target}")
                success += 1
                continue
            target.unlink()
            print(f"  ✓ Removed: {target}")
            success += 1

    print(f"\nDone: {success} removed, {failed} failed")
    return success, failed


def status() -> None:
    """Show status of all managed dotfiles."""
    print(f"Dotfiles status (repo: {REPO_ROOT})")
    print()

    for source, target in symlink_map().items():
        if not source.exists():
            status_str = "⚠ MISSING SOURCE"
        elif target.is_symlink():
            current = target.readlink()
            if current == source:
                status_str = "✓ LINKED"
            else:
                status_str = f"✗ WRONG TARGET ({current})"
        elif target.exists():
            status_str = "✗ EXISTS (not symlink)"
        else:
            status_str = "○ NOT INSTALLED"

        print(f"  {status_str:30} {target.relative_to(HOME)}")

    print()
    print("Hidden desktop entries:")
    if APPLICATIONS_DIR.is_dir():
        for source in sorted(APPLICATIONS_DIR.glob("*.desktop")):
            target = USER_APPLICATIONS / source.name
            if not target.exists():
                status_str = "○ NOT COPIED"
            elif target.read_bytes() == source.read_bytes():
                status_str = "✓ HIDDEN"
            else:
                status_str = "✗ DIFFERS"
            print(f"  {status_str:30} {source.name}")


def main():
    import argparse

    parser = argparse.ArgumentParser(description="Manage dotfiles")
    parser.add_argument(
        "command",
        choices=["install", "uninstall", "status"],
        help="Command to run",
    )
    parser.add_argument(
        "-f", "--force", action="store_true", help="Force overwrite existing files"
    )
    parser.add_argument(
        "-r",
        "--repair",
        action="store_true",
        help="Force re-link/copy, replacing anything in the way",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="Show what would be done without making changes",
    )

    args = parser.parse_args()

    if args.command == "install":
        install(force=args.force, dry_run=args.dry_run, repair=args.repair)
    elif args.command == "uninstall":
        uninstall(dry_run=args.dry_run)
    elif args.command == "status":
        status()


if __name__ == "__main__":
    main()
